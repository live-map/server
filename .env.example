# ===========================================
# Livemap Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Application
APP_NAME=Livemap API
DEBUG=False

# ===========================================
# Database (PostgreSQL + pgvector)
# ===========================================
DATABASE_URL=postgresql+asyncpg://livemap:your_password@localhost:5432/livemap

# ===========================================
# Authentication (REQUIRED)
# ===========================================
# MUST match the AUTH_SECRET in the frontend's .env file
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_secret_here

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# ===========================================
# Publishable Criteria
# ===========================================
PUBLISHABLE_MIN_CREDIBILITY=60
PUBLISHABLE_REQUIRE_LOCATION=false

# ===========================================
# AI Research Agent (Fact Research)
# ===========================================

# LLM Provider: "anthropic" or "openai" (auto-detected from keys if empty)
AI_PROVIDER=

# Anthropic API Key (Claude Sonnet 4.5)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI API Key (GPT-4o) — alternative to Anthropic
# https://platform.openai.com/
OPENAI_API_KEY=

# Default model (fallback for nodes without specific model)
AI_MODEL=claude-sonnet-4-5-20250929

# Per-node model (v2 multi-model: each node uses optimal model)
AI_MODEL_PLANNER=gpt-4o-mini
AI_MODEL_SYNTHESIZER=claude-sonnet-4-5-20250929
AI_MODEL_REVIEWER=gpt-4o

# Tavily API (Free: 1,000/month)
# https://tavily.com/
TAVILY_API_KEY=tvly-your-key-here

# Semantic Scholar API Key (optional, higher rate limits)
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Google Fact Check API Key (optional, free)
# https://console.cloud.google.com/apis/library/factchecktools.googleapis.com
GOOGLE_FACT_CHECK_API_KEY=

# ===========================================
# News Sources
# ===========================================

# GDELT (Free, no key needed)
AGENT_GDELT_ENABLED=true
AGENT_GDELT_TIMESPAN=30min

# Currents API (Free: 600/day)
# https://currentsapi.services/en/register
AGENT_CURRENTS_ENABLED=true
AGENT_CURRENTS_API_KEY=your-currents-key-here

# World News API (Free: 100/day)
# https://worldnewsapi.com/
AGENT_WORLDNEWS_ENABLED=true
AGENT_WORLDNEWS_API_KEY=your-worldnews-key-here

# Brave Search (Free: 2,000/month)
# https://brave.com/search/api/
AGENT_BRAVE_API_KEY=your-brave-key-here

# ===========================================
# Scanner Settings
# ===========================================
AGENT_SCAN_INTERVAL_MINUTES=15
