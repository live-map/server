# ===========================================
# Grapoll Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Application
APP_NAME=Grapoll API
DEBUG=False

# ===========================================
# Database (PostgreSQL)
# ===========================================
DATABASE_URL=postgresql+asyncpg://livemap:your_password@localhost:5432/livemap

# ===========================================
# Authentication (REQUIRED)
# ===========================================
# MUST match the AUTH_SECRET in the frontend's .env file
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_secret_here

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# ===========================================
# AWS S3 (Media Uploads)
# ===========================================
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_CLOUDFRONT_DOMAIN=

# ===========================================
# AI Research Agent (Fact Research)
# ===========================================

# LLM Provider: "anthropic" or "openai" (auto-detected from keys if empty)
AI_PROVIDER=

# Anthropic API Key (Claude Sonnet 4.5)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI API Key (GPT-4o) — alternative to Anthropic
# https://platform.openai.com/
OPENAI_API_KEY=

# Default model (fallback for nodes without specific model)
AI_MODEL=claude-sonnet-4-5-20250929

# Per-node model (v2 multi-model: each node uses optimal model)
AI_MODEL_PLANNER=gpt-4o-mini
AI_MODEL_SYNTHESIZER=claude-sonnet-4-5-20250929
AI_MODEL_REVIEWER=gpt-4o

# Tavily API (Free: 1,000/month)
# https://tavily.com/
TAVILY_API_KEY=tvly-your-key-here

# Semantic Scholar API Key (optional, higher rate limits)
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Google Fact Check API Key (optional, free)
# https://console.cloud.google.com/apis/library/factchecktools.googleapis.com
GOOGLE_FACT_CHECK_API_KEY=
