# ===========================================
# Livemap Backend Environment Variables
# ===========================================

# Application
APP_NAME=Livemap API
DEBUG=true

# ===========================================
# Database (PostgreSQL + pgvector)
# ===========================================
DATABASE_URL=postgresql+asyncpg://livemap:livemap123@localhost:5432/livemap

# ===========================================
# Telegram API (https://my.telegram.org/apps)
# ===========================================
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+821012345678

# ===========================================
# Stage 2: RAG Pipeline (SearXNG)
# ===========================================

# Self-hosted SearXNG for evidence retrieval
SEARXNG_URL=http://localhost:8888

# ===========================================
# Stage 3: LLM API (Paid ~$2/month)
# ===========================================

# Mistral AI
# Get API key: https://console.mistral.ai/
# Pricing: $0.10/1M input, $0.30/1M output tokens
MISTRAL_API_KEY=your_mistral_api_key

# ===========================================
# Scheduler (Optional)
# ===========================================

# Enable background collection (true/false)
ENABLE_SCHEDULER=false

# Telegram channels to monitor (comma-separated)
# Example: war_monitor,conflict_news,military_updates
TELEGRAM_CHANNELS=

# ===========================================
# Autonomous Agent (NEW)
# ===========================================

# OpenAI API Key (for GPT-4o-mini - cheap!)
# Get API key: https://platform.openai.com/
# Pricing: $0.15/1M input, $0.60/1M output (gpt-4o-mini)
AGENT_OPENAI_API_KEY=your_openai_api_key

# Tavily API Key (for web search)
# Get API key: https://tavily.com/ (Free: 1,000 searches/month)
AGENT_TAVILY_API_KEY=your_tavily_api_key

# Agent Settings
AGENT_LLM_MODEL=gpt-4o-mini
AGENT_SCAN_INTERVAL_MINUTES=15
AGENT_MAX_INVESTIGATION_ITERATIONS=3
