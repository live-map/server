# ===========================================
# Livemap Backend Environment Variables
# ===========================================

# Application
APP_NAME=Livemap API
DEBUG=true

# ===========================================
# Database (PostgreSQL + pgvector)
# ===========================================
DATABASE_URL=postgresql+asyncpg://livemap:livemap123@localhost:5432/livemap

# ===========================================
# Publishable Criteria
# ===========================================
PUBLISHABLE_MIN_CREDIBILITY=60
PUBLISHABLE_REQUIRE_LOCATION=false

# ===========================================
# Autonomous Agent
# ===========================================

# OpenAI API Key (for GPT-4o-mini - cheap!)
# Get API key: https://platform.openai.com/
# Pricing: $0.15/1M input, $0.60/1M output (gpt-4o-mini)
AGENT_OPENAI_API_KEY=your_openai_api_key

# Tavily API Key (for web search)
# Get API key: https://tavily.com/ (Free: 1,000 searches/month)
AGENT_TAVILY_API_KEY=your_tavily_api_key

# Agent Settings
AGENT_LLM_MODEL=gpt-4o-mini
AGENT_SCAN_INTERVAL_MINUTES=15
AGENT_MAX_INVESTIGATION_ITERATIONS=3

# ===========================================
# Multi-Source Triggers (NEW)
# ===========================================
# 다중 소스에서 실시간 이벤트 감지
# GDELT (뉴스) + X/Twitter + Telegram 병렬 모니터링

# --- GDELT (뉴스, 100,000+ 소스, 무료) ---
AGENT_GDELT_ENABLED=true
AGENT_GDELT_TIMESPAN=1h

# --- X/Twitter (Twikit - 개인계정, 무료) ---
# 주의: ToS 위반 가능성, 부계정 권장
# 쿠키 파일 있으면 로그인 스킵
AGENT_TWITTER_ENABLED=false
AGENT_TWITTER_USERNAME=your_twitter_username
AGENT_TWITTER_EMAIL=your_twitter_email
AGENT_TWITTER_PASSWORD=your_twitter_password
AGENT_TWITTER_COOKIES_PATH=twitter_cookies.json

# --- Telegram (Telethon - 가입채널만, 무료) ---
# API 인증: https://my.telegram.org/apps
# 채널은 사전 가입 필요 (개인/비공개 채널 접근 불가)
AGENT_TELEGRAM_ENABLED=false
AGENT_TELEGRAM_API_ID=your_telegram_api_id
AGENT_TELEGRAM_API_HASH=your_telegram_api_hash
AGENT_TELEGRAM_PHONE=+821012345678
AGENT_TELEGRAM_SESSION_PATH=telegram_session
# 모니터링할 채널 (콤마 구분, 빈칸이면 기본 OSINT 채널)
# 예: ukrainenowenglish,nexta_live,IranIntl,GeoConfirmed
AGENT_TELEGRAM_CHANNELS=
