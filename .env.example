# ===========================================
# Livemap Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Application
APP_NAME=Livemap API
DEBUG=False

# ===========================================
# Database (PostgreSQL + pgvector)
# ===========================================
DATABASE_URL=postgresql+asyncpg://livemap:your_password@localhost:5432/livemap

# ===========================================
# Authentication (REQUIRED)
# ===========================================
# MUST match the AUTH_SECRET in the frontend's .env file
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_secret_here

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# ===========================================
# Publishable Criteria
# ===========================================
PUBLISHABLE_MIN_CREDIBILITY=60
PUBLISHABLE_REQUIRE_LOCATION=false

# ===========================================
# LLM Settings
# ===========================================

# OpenAI API Key (for GPT-4o-mini)
# https://platform.openai.com/
AGENT_OPENAI_API_KEY=sk-your-openai-key-here
AGENT_LLM_MODEL=gpt-4o-mini

# Tavily API (Free: 1,000/month)
# https://tavily.com/
AGENT_TAVILY_API_KEY=tvly-your-key-here

# Deepinfra API for LLM Classifier (~$3-5/month)
# https://deepinfra.com/dash/api_keys
AGENT_DEEPINFRA_API_KEY=your-deepinfra-key-here

# ===========================================
# News Sources
# ===========================================

# GDELT (Free, no key needed)
AGENT_GDELT_ENABLED=true
AGENT_GDELT_TIMESPAN=30min

# Currents API (Free: 600/day)
# https://currentsapi.services/en/register
AGENT_CURRENTS_ENABLED=true
AGENT_CURRENTS_API_KEY=your-currents-key-here

# World News API (Free: 100/day)
# https://worldnewsapi.com/
AGENT_WORLDNEWS_ENABLED=true
AGENT_WORLDNEWS_API_KEY=your-worldnews-key-here

# Brave Search (Free: 2,000/month)
# https://brave.com/search/api/
AGENT_BRAVE_API_KEY=your-brave-key-here

# ===========================================
# Scanner Settings
# ===========================================
AGENT_SCAN_INTERVAL_MINUTES=15
