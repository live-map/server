# ===========================================
# Livemap Backend Environment Variables
# ===========================================

# Application
APP_NAME=Livemap API
DEBUG=true

# ===========================================
# Database (PostgreSQL + pgvector)
# ===========================================
DATABASE_URL=postgresql+asyncpg://livemap:livemap123@localhost:5432/livemap

# ===========================================
# Telegram API (https://my.telegram.org/apps)
# ===========================================
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+821012345678

# ===========================================
# Stage 2: External APIs (Free)
# ===========================================

# ClaimBuster - Check-worthiness scoring
# Get API key: https://idir.uta.edu/claimbuster/
CLAIMBUSTER_API_KEY=your_claimbuster_api_key

# Google Fact Check Tools API
# Get API key: https://console.cloud.google.com/apis/credentials
# Enable: Fact Check Tools API
GOOGLE_API_KEY=your_google_api_key

# ===========================================
# Stage 3: LLM API (Paid ~$2/month)
# ===========================================

# Mistral AI
# Get API key: https://console.mistral.ai/
# Pricing: $0.10/1M input, $0.30/1M output tokens
MISTRAL_API_KEY=your_mistral_api_key

# ===========================================
# Scheduler (Optional)
# ===========================================

# Enable background collection (true/false)
ENABLE_SCHEDULER=false

# Telegram channels to monitor (comma-separated)
# Example: war_monitor,conflict_news,military_updates
TELEGRAM_CHANNELS=
